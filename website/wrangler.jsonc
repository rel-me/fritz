{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fritz-updates",
  "main": "./worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "fritz.rel.me",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rel-site-db",
      "database_id": "9d097479-5ca3-4427-bc6e-bfd9b99f8bef"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPDATES",
      "bucket_name": "fritz-updates"
    }
  ]
}
